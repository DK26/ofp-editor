# rust-weak-models: only hand-written sources are committed (see README, "What is committed").

# Cargo build output of this standalone workspace.
/target/

# Everything a run writes: JSONL records, saved model replies and code (--save-dir),
# logs, listings and system prompts, dry-run prompts, conformance dumps, mutant records,
# the power simulation's output and the live driver's status files.
/results/

# Generated by `python runner.py scaffold` (deterministic; regenerate instead of editing).
/tasks/*/plain/
/tasks/*/guided/
/pilot/*/plain/
/pilot/*/guided/
# Regenerated offline by scaffold; the workspace has no external dependencies, so the lock
# only lists this folder's own path crates.
/Cargo.lock

# A local copy of live/arms.json with this machine's model locations.
/live/arms.local.json
